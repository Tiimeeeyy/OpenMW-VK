#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

const uint MAX_LIGHTS_PER_TILE = 63u;

struct PointLight
{
    vec4 posRadius;
    vec4 colorIntensity;
};

struct TileLightList
{
    uint count;
    uint indices[63];
};

layout(set = 0, binding = 0) uniform FrameData
{
    mat4 view;
    mat4 proj;
    mat4 viewProj;
    mat4 invProj;
    mat4 cascadeViewProj[3];
    vec4 cascadeSplits;
    vec4 cameraPos;
    vec4 sunDir;
    vec4 sunColor;
    vec4 ambientColor;
    vec4 fogColor;
    vec4 fogParams;
    vec4 screenParams;
    vec4 visualParams;
    vec4 frustumPlanes[6];
} frame;

layout(std430, set = 0, binding = 3) readonly buffer LightBuffer
{
    PointLight lights[];
};

layout(std430, set = 1, binding = 4) writeonly buffer TileLightBuffer
{
    TileLightList tiles[];
};

vec3 screenToView(vec2 ndc)
{
    vec4 v = frame.invProj * vec4(ndc, 1.0, 1.0);
    return v.xyz / v.w;
}

vec4 makePlaneFromOrigin(vec3 a, vec3 b)
{
    return vec4(normalize(cross(a, b)), 0.0);
}

void main()
{
    uint tileX = gl_GlobalInvocationID.x;
    uint tileY = gl_GlobalInvocationID.y;
    uint tileCountX = uint(frame.screenParams.z);
    uint tileCountY = uint(frame.screenParams.w);
    if (tileX >= tileCountX || tileY >= tileCountY)
        return;

    uint tileIdx = tileY * tileCountX + tileX;

    vec2 invScreen = 1.0 / max(frame.screenParams.xy, vec2(1.0));
    vec2 tileMinPx = vec2(tileX, tileY) * 16.0;
    vec2 tileMaxPx = min(tileMinPx + vec2(16.0), frame.screenParams.xy);

    vec2 ndcMin = tileMinPx * invScreen * 2.0 - 1.0;
    vec2 ndcMax = tileMaxPx * invScreen * 2.0 - 1.0;

    vec3 tl = screenToView(vec2(ndcMin.x, ndcMin.y));
    vec3 tr = screenToView(vec2(ndcMax.x, ndcMin.y));
    vec3 bl = screenToView(vec2(ndcMin.x, ndcMax.y));
    vec3 br = screenToView(vec2(ndcMax.x, ndcMax.y));

    vec4 planes[4];
    planes[0] = makePlaneFromOrigin(tl, bl);
    planes[1] = makePlaneFromOrigin(br, tr);
    planes[2] = makePlaneFromOrigin(tr, tl);
    planes[3] = makePlaneFromOrigin(bl, br);

    uint lightCount = uint(frame.fogParams.y);
    uint visibleCount = 0u;

    for (uint i = 0u; i < lightCount && visibleCount < MAX_LIGHTS_PER_TILE; ++i)
    {
        float radius = lights[i].posRadius.w;
        if (radius <= 0.0)
            continue;

        vec3 viewPos = (frame.view * vec4(lights[i].posRadius.xyz, 1.0)).xyz;
        if (viewPos.z - radius > 0.0)
            continue;

        bool inside = true;
        for (int p = 0; p < 4; ++p)
        {
            if (dot(planes[p].xyz, viewPos) < -radius)
            {
                inside = false;
                break;
            }
        }
        if (inside)
        {
            tiles[tileIdx].indices[visibleCount] = i;
            visibleCount++;
        }
    }

    tiles[tileIdx].count = visibleCount;
}
