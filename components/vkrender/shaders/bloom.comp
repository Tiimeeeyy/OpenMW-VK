#version 450

// Half-res bright-pass + 9-tap tent blur for subtle HDR Bloom
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D gInput;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D gOutput;

layout(push_constant) uniform BloomPC
{
    uint passMode; // 0 = bright threshold downsample, 1 = 9-tap tent blur
    float threshold;
} pc;

vec3 softThreshold(vec3 c, float thresh)
{
    float luma = dot(c, vec3(0.2126, 0.7152, 0.0722));
    float knee = thresh * 0.5;
    float soft = clamp(luma - thresh + knee, 0.0, 2.0 * knee);
    soft = (soft * soft) / max(4.0 * knee, 1e-4);
    float contrib = max(soft, luma - thresh) / max(luma, 1e-4);
    return c * max(contrib, 0.0);
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(gOutput);
    if (coord.x >= size.x || coord.y >= size.y)
        return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(size);
    vec2 texel = 1.0 / vec2(size);

    if (pc.passMode == 0u)
    {
        vec3 c0 = texture(gInput, uv + vec2(-0.5, -0.5) * texel).rgb;
        vec3 c1 = texture(gInput, uv + vec2(0.5, -0.5) * texel).rgb;
        vec3 c2 = texture(gInput, uv + vec2(-0.5, 0.5) * texel).rgb;
        vec3 c3 = texture(gInput, uv + vec2(0.5, 0.5) * texel).rgb;
        vec3 avg = (c0 + c1 + c2 + c3) * 0.25;
        vec3 bright = min(softThreshold(avg, pc.threshold), vec3(6.0));
        imageStore(gOutput, coord, vec4(bright, 1.0));
    }
    else
    {
        vec2 off = texel * 1.75;
        vec3 sum = texture(gInput, uv).rgb * 4.0;
        sum += texture(gInput, uv + vec2(-off.x, 0.0)).rgb * 2.0;
        sum += texture(gInput, uv + vec2(off.x, 0.0)).rgb * 2.0;
        sum += texture(gInput, uv + vec2(0.0, -off.y)).rgb * 2.0;
        sum += texture(gInput, uv + vec2(0.0, off.y)).rgb * 2.0;
        sum += texture(gInput, uv + vec2(-off.x, -off.y)).rgb;
        sum += texture(gInput, uv + vec2(off.x, -off.y)).rgb;
        sum += texture(gInput, uv + vec2(-off.x, off.y)).rgb;
        sum += texture(gInput, uv + vec2(off.x, off.y)).rgb;
        imageStore(gOutput, coord, vec4(sum / 16.0, 1.0));
    }
}
